rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /bookings/{bookingId} {
      allow create, read, write: if true;
    }
    
    match /users/{userId} {
      allow create, read, write: if true;
    }
    
    match /sessions/{sessionId} {
      allow create, read, write: if true;
    }
  }
}
